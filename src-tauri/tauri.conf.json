{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Immich Desktop",
  "version": "0.1.0",
  "identifier": "app.immichdesktop.wrapper",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Immich Desktop — Setup", "width": 900, "height": 720, "visible": false, "dragDropEnabled": false }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["local", "local-reset"]
    }
  },
  "bundle": { "active": true, "targets": "all", "macOS": { "minimumSystemVersion": "11.0" }, "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"] }
}
